# =========================
# SERVER
# =========================
SERVER_PORT=8080

# =========================
# POSTGRESQL
# =========================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=federation_agricole
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JDBC URL (utilisé directement en SQL pur)
DB_URL=jdbc:postgresql://localhost:5432/federation_agricole

# =========================
# OPTIONAL CONFIG
# =========================
DB_DRIVER=org.postgresql.Driver

# Logging SQL manuel (si tu fais des logs toi-même)
SHOW_SQL=true